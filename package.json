{
  "name": "salimon",
  "private": true,
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "dev:mobile": "pnpm --filter @salimon/mobile start",
    "dev:web": "pnpm --filter @salimon/web dev",
    "android:mobile": "pnpm --filter @salimon/mobile android",
    "prebuild:mobile": "pnpm --filter @salimon/mobile prebuild:android",
    "dev:seoulsys": "set \"PATH=%LOCALAPPDATA%\\Volta\\tools\\image\\node\\24.15.0;%PATH%\" && %LOCALAPPDATA%\\pnpm\\bin\\pnpm.CMD --filter @salimon/web dev",
    "build:web": "pnpm --filter @salimon/web build",
    "build:mobile:family-alpha": "pnpm --filter @salimon/mobile build:family-alpha",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "pnpm -r --if-present lint",
    "test": "pnpm -r --if-present test"
  },
  "devDependencies": {
    "@types/node": "^26.0.1",
    "eslint": "^9.39.4",
    "prettier": "latest",
    "typescript": "latest",
    "vitest": "latest"
  },
  "volta": {
    "node": "24.15.0"
  }
}
